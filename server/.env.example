# ---- Task360 server edition — copy to .env.local (local) or set in your host's settings ----
# Public URL of the app (used in sign-in links and notification emails)
APP_URL=http://localhost:3000

# Supabase → Project settings → Database → Connection string (use the "Transaction pooler", port 6543, on serverless hosts)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret, used for private file storage. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=task-attachments

# Show "Sign in with Microsoft" (configure the Azure provider in Supabase → Authentication → Providers first)
MICROSOFT_SSO_ENABLED=false

# Shared secret for the scheduled job (/api/cron). Generate with: openssl rand -hex 32
CRON_SECRET=

# ---- Outlook email through Microsoft Graph (optional) ----
# Entra ID app registration with APPLICATION permission Mail.Send (admin consent granted)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Mailbox the app sends from, e.g. task360@yourcompany.com
MS_SENDER_EMAIL=
# Notification types NOT emailed (comma separated)
EMAIL_SKIP_TYPES=comment

# ---- Microsoft Teams (optional) ----
# Teams channel → ⋯ → Workflows → "Post to a channel when a webhook request is received" → copy URL
TEAMS_WEBHOOK_URL=
TEAMS_NOTIFY_TYPES=overdue,escalation1,escalation2,digest,weekly_summary,monthly_kpi

# ---- Local development only (ignored in production builds) ----
DEV_LOGIN=false
